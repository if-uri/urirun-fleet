# urirun-fleet environment configuration example
# Copy to .env and adjust values as needed. Never commit real secrets.

# Target node endpoint (e.g. a urirun node /health endpoint)
URIRUN_FLEET_NODE_URI=http://192.168.0.201:8766

# Desired-state manifest location (YAML)
URIRUN_FLEET_DESIRED_STATE=./desired.yaml

# Execution mode: plan (dry-run) or execute
URIRUN_FLEET_MODE=plan
